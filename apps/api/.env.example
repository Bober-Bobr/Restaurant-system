# ── API configuration ────────────────────────────────────────────────────────
# Copy to `apps/api/.env` and fill in. That file is gitignored: it belongs to
# the machine, not to the repository. It used to be committed, which meant a
# `git stash`, `checkout` or `reset` could silently restore development values
# over a server's real configuration — losing the database, the signing secret
# and both Telegram bots at once.
#
# A `# required` marker below is not decoration: `envFile.test.ts` enforces it
# on the server during deploy (deploy.sh runs the suite with VMENU_DEPLOY=1).
# If you genuinely stop using something, remove its marker here — deliberately,
# in a commit somebody can read — rather than letting the deploy fail.

# required
# Postgres in production. A `file:` URL is the local-development database and
# is refused on a deploy, since schema.prisma is `provider = "postgresql"`.
DATABASE_URL="postgresql://user:password@localhost:5432/vmenu"

PORT=4000

# required
# At least 32 characters, and never the placeholder text. Every access and
# refresh token is signed with this; changing it signs everybody out.
JWT_SECRET="replace-with-at-least-32-random-characters"

# Optional legacy header auth (Bearer JWT is preferred).
# ADMIN_API_KEY="change-me-please"

# Enables "Sign in with Google" on v-invite.uz. Without it the button is hidden.
# GOOGLE_CLIENT_ID=""

# ── Telegram ─────────────────────────────────────────────────────────────────
# The main bot forwards flyer form submissions; the optional second bot handles
# guest-invitation RSVPs (when unset, the main bot serves both).
#
# THE SILENT FAILURE TO KNOW ABOUT: `registerWebhook()` runs once on boot and
# returns without a word if TELEGRAM_PUBLIC_URL or the webhook secret is
# missing. The API starts, the logs look normal, and the bot never receives
# another message. The three below therefore travel together.

# required
TELEGRAM_BOT_TOKEN=""

# required
# Guards the public webhook path and is sent as Telegram's secret_token.
TELEGRAM_WEBHOOK_SECRET=""

# required
# Where Telegram should POST updates — the origin only, e.g. https://event.v-menu.uz
TELEGRAM_PUBLIC_URL="https://event.v-menu.uz"

# Used to build t.me deep links. Fetched via getMe when omitted.
# TELEGRAM_BOT_USERNAME=""

# Second bot, dedicated to invitation RSVPs. Optional: without it the main bot
# handles them too. Its webhook secret falls back to TELEGRAM_WEBHOOK_SECRET.
# TELEGRAM_INVITE_BOT_TOKEN=""
# TELEGRAM_INVITE_WEBHOOK_SECRET=""
# TELEGRAM_INVITE_BOT_USERNAME=""
