generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum EventType {
  RESERVATION
  BANQUET
  WEDDING
  BIRTHDAY
  PRIVATE_PARTY
  CORPORATE
  FOTIHA_TUI
  NACHOR_OSHI
}

enum MenuCategory {
  SOUPS
  PIZZA
  COLD_APPETIZERS
  GRILL
  PASTRY
  HOT_APPETIZERS
  BEER_SNACKS
  DESSERT
  LAMB_DISHES
  BEEF_DISHES
  CHICKEN_DISHES
  SIDE_DISHES
  PASTA
  SOFT_DRINKS
  STEAKS
  ENERGY_DRINKS
  SALADS_OIL
  SALADS_MAYO
  COFFEE
  SUSHI_ROLLS
  DRIED_FRUITS
  CANDIES
  // Legacy values kept for existing data and the tablet course-choice feature.
  FIRST_COURSE
  SECOND_COURSE
  THIRD_COURSE
  SWEETS
  FRUITS
  ALCOHOL
  LEMONADES
  NON_ALCOHOLIC_COCKTAILS
  ALCOHOLIC_COCKTAILS
  MILKSHAKES
  TEA_MENU
  FRESH_JUICES
  LIQUEURS
}

enum Region {
  US
  CA
  GB
  DE
  FR
  IT
  ES
  RU
  CN
  JP
  KR
  AU
  UZ
  EU
}

model Event {
  id              String            @id @default(cuid())
  eventNumber     Int               @unique @default(0)
  customerName    String
  customerPhone   String?
  eventDate       DateTime
  guestCount      Int
  status          EventStatus       @default(DRAFT)
  eventType            EventType         @default(RESERVATION)
  region               Region?
  hallId               String?
  tableCategoryId      String?
  restaurantId         String?
  notes                String?
  birthdayPersonName   String?
  brideName            String?
  groomName            String?
  honoreePersonName    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  selections      EventMenuSelection[]
  invitation      Invitation?
  hall            Hall?             @relation(fields: [hallId], references: [id], onDelete: SetNull)
  tableCategory   TableCategory?    @relation(fields: [tableCategoryId], references: [id], onDelete: SetNull)
  restaurant      Restaurant?       @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([hallId])
  @@index([tableCategoryId])
  @@index([restaurantId])
}

enum AdminRole {
  CHIEF_ADMIN
  MANAGER
  OWNER
  ADMIN
  CATERING_ADMIN
  EMPLOYEE
  KITCHEN
}

model AdminUser {
  id               String       @id @default(cuid())
  username         String       @unique
  passwordHash     String
  refreshTokenHash String?
  role             AdminRole    @default(OWNER)
  restaurantId     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  ownedRestaurants Restaurant[] @relation("OwnedRestaurants")
  restaurant       Restaurant?  @relation("StaffRestaurant", fields: [restaurantId], references: [id], onDelete: SetNull)
  companies        Company[]
  sessions         Session[]

  @@index([restaurantId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  user             AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id          String       @id @default(cuid())
  name        String
  logoUrl     String?
  ownerId     String
  owner       AdminUser    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurants Restaurant[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([ownerId])
}

model Restaurant {
  id              String          @id @default(cuid())
  name            String
  address         String?
  phone           String?
  email           String?
  history         String?
  logoUrl         String?
  backgroundImageUrl String?
  categoryOrder   String?
  ownerId         String
  companyId       String?
  owner           AdminUser       @relation("OwnedRestaurants", fields: [ownerId], references: [id], onDelete: Cascade)
  company         Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  staff           AdminUser[]     @relation("StaffRestaurant")
  events          Event[]
  menuItems       MenuItem[]
  tableCategories TableCategory[]
  halls           Hall[]
  invitations     Invitation[]
  reviews         Review[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([ownerId])
  @@index([companyId])
}

model Review {
  id           String     @id @default(cuid())
  restaurantId String
  authorName   String
  rating       Int
  text         String?
  photoUrl     String?
  isApproved   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model TableCategory {
  id                 String                    @id @default(cuid())
  name               String
  includedCategories String                    @default("")
  ratePerPerson      Int                       @default(0)
  discountPercent    Int                       @default(0)
  description        String?
  photoUrl           String?
  photos             Json                      @default("[]")
  isActive           Boolean                   @default(true)
  restaurantId       String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  events             Event[]
  packageItems       TableCategoryMenuItem[]
  restaurant         Restaurant?               @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model TableCategoryMenuItem {
  id              String        @id @default(cuid())
  tableCategoryId String
  menuItemId      String
  servings        Int           @default(1)
  tableCategory   TableCategory @relation(fields: [tableCategoryId], references: [id], onDelete: Cascade)
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([tableCategoryId, menuItemId])
  @@index([tableCategoryId])
}

model Hall {
  id           String      @id @default(cuid())
  name         String
  capacity     Int
  description  String?
  photoUrl     String?
  photos       Json        @default("[]")
  isActive     Boolean     @default(true)
  restaurantId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  events       Event[]
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model MenuItem {
  id               String                    @id @default(cuid())
  name             String
  description      String?
  category         MenuCategory
  priceCents       Int
  photoUrl         String?
  isActive         Boolean                   @default(true)
  showOnTablet     Boolean                   @default(true)
  isBestseller     Boolean                   @default(false)
  isOutOfStock     Boolean                   @default(false)
  sortOrder        Int                       @default(0)
  restaurantId     String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  selections       EventMenuSelection[]
  packageCategories TableCategoryMenuItem[]
  restaurant       Restaurant?              @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([category, isActive])
  @@index([restaurantId])
}

model EventMenuSelection {
  id             String   @id @default(cuid())
  eventId        String
  menuItemId     String
  quantity       Int
  unitPriceCents Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([eventId, menuItemId])
  @@index([eventId])
}

model Invitation {
  id              String    @id @default(cuid())
  slug            String    @unique
  eventId         String?   @unique
  restaurantId    String
  createdById     String?

  // Top hero card (gift / promo)
  promoTitle      String?
  promoSubtitle   String?
  promoCode       String?
  promoImageUrl   String?

  // Secondary promo block under hero
  promoCodeAlt    String?
  promoDescription String?

  // Telegram CTA
  telegramUrl     String?
  telegramLabel   String?

  // Welcome / venue card
  welcomeTitle    String?
  welcomeSubtitle String?
  welcomeImageUrl String?
  welcomeMessage  String?

  // Countdown
  countdownAt     DateTime?
  countdownLabel  String?

  // Menu showcase items (JSON array of { number, name, photoUrl })
  menuItems       Json      @default("[]")

  // Photo gallery (JSON array of strings)
  galleryPhotos   Json      @default("[]")

  // Social + contacts
  instagramUrl    String?
  instagramLabel  String?
  phone           String?
  contactsTitle   String?
  contactVCardUrl String?

  // Theme / palette
  accentColor         String?
  backgroundColor     String?
  backgroundImageUrl  String?

  // Optional looping background music played on the public invitation
  musicUrl            String?

  isPublished     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event       Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([eventId])
}
