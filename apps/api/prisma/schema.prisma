generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  COMPLETED
  MENU_NOT_SELECTED
}

enum EventType {
  RESERVATION
  BANQUET
  WEDDING
  BIRTHDAY
  PRIVATE_PARTY
  CORPORATE
  FOTIHA_TUI
  NACHOR_OSHI
}

enum MenuCategory {
  SOUPS
  PIZZA
  COLD_APPETIZERS
  GRILL
  PASTRY
  HOT_APPETIZERS
  BEER_SNACKS
  DESSERT
  LAMB_DISHES
  BEEF_DISHES
  CHICKEN_DISHES
  SIDE_DISHES
  PASTA
  SOFT_DRINKS
  STEAKS
  ENERGY_DRINKS
  SALADS_OIL
  SALADS_MAYO
  COFFEE
  SUSHI_ROLLS
  DRIED_FRUITS
  CANDIES
  // Legacy values kept for existing data and the tablet course-choice feature.
  FIRST_COURSE
  SECOND_COURSE
  THIRD_COURSE
  SWEETS
  FRUITS
  ALCOHOL
  LEMONADES
  NON_ALCOHOLIC_COCKTAILS
  ALCOHOLIC_COCKTAILS
  MILKSHAKES
  TEA_MENU
  FRESH_JUICES
  LIQUEURS
}

enum Region {
  US
  CA
  GB
  DE
  FR
  IT
  ES
  RU
  CN
  JP
  KR
  AU
  UZ
  EU
}

model Event {
  id              String            @id @default(cuid())
  eventNumber     Int               @unique @default(0)
  customerName    String
  customerPhone   String?
  // Optional second contact person for the event.
  secondCustomerName  String?
  secondCustomerPhone String?
  eventDate       DateTime
  // Set when an event is rescheduled: preserves the date it was moved FROM so the
  // UI can show the change (old date → new date). Null = never rescheduled.
  originalEventDate DateTime?
  guestCount      Int
  // Prepaid deposit in tiyin (1/100 so'm); subtracted from the event total.
  depositCents    Int               @default(0)
  // Deadline for settling the remaining balance once the event has started with
  // an outstanding amount (a "debt"). Past-due debts surface as notifications.
  debtDeadline    DateTime?
  status          EventStatus       @default(DRAFT)
  eventType            EventType         @default(RESERVATION)
  region               Region?
  hallId               String?
  tableCategoryId      String?
  // Optional children's table add-on chosen on the tablet (plain refs, no FK).
  childrenTableCategoryId String?
  childrenCount        Int               @default(0)
  // Full tablet menu-selection snapshot (courses, free swaps, extras, children)
  // so the event round-trips between the Events page and the Tablet page.
  menuConfig           Json?
  restaurantId         String?
  notes                String?
  birthdayPersonName   String?
  brideName            String?
  groomName            String?
  honoreePersonName    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  selections      EventMenuSelection[]
  payments        EventPayment[]
  invitation      Invitation?
  hall            Hall?             @relation(fields: [hallId], references: [id], onDelete: SetNull)
  tableCategory   TableCategory?    @relation(fields: [tableCategoryId], references: [id], onDelete: SetNull)
  restaurant      Restaurant?       @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([hallId])
  @@index([tableCategoryId])
  @@index([restaurantId])
}

// A partial (installment) payment towards an event's invoice, in tiyin.
// The invoice's outstanding balance = total − deposit − sum(payments).
model EventPayment {
  id          String   @id @default(cuid())
  eventId     String
  amountCents Int
  note        String?
  createdAt   DateTime @default(now())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

enum AdminRole {
  CHIEF_ADMIN
  MANAGER
  OWNER
  ADMIN
  CATERING_ADMIN
  RESTAURANT_MANAGER
  EMPLOYEE
  KITCHEN
  // v-connect.uz — builds NFC plaques for businesses. Not tied to a restaurant.
  NFC_MAKER
  // Additional Services — a performer (musician, singer, dancer…) with their own
  // profile, calendar and booking inbox. Not tied to a restaurant.
  PERFORMER
  // Additional Services — an event host (тамада / boshlovchi). A distinct role
  // from PERFORMER, listed in its own block, but sharing the profile, calendar
  // and booking machinery below. The one difference is the event programme,
  // which a client must supply when booking and a host may record per booking.
  HOST
  // Food-service employee — the counterpart to CATERING_ADMIN, working the floor
  // with guest order codes. Restaurant-scoped, signs in at
  // food-admin.v-menu.uz/<slug> and sees only the Orders and Statistics tabs.
  // Gated on moduleCatering, the same entitlement as CATERING_ADMIN.
  // NOT the banquet EMPLOYEE role, which is a separate product and unchanged.
  CATERING_EMPLOYEE
}

model AdminUser {
  id               String       @id @default(cuid())
  username         String       @unique
  passwordHash     String
  refreshTokenHash String?
  role             AdminRole    @default(OWNER)
  restaurantId     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  ownedRestaurants Restaurant[] @relation("OwnedRestaurants")
  restaurant       Restaurant?  @relation("StaffRestaurant", fields: [restaurantId], references: [id], onDelete: SetNull)
  companies        Company[]
  sessions         Session[]
  expenseDays      ExpenseDay[] @relation("ManagerExpenseDays")
  guestInvitations GuestInvitation[] @relation("ManagerGuestInvitations")
  designTemplates  DesignTemplate[] @relation("ManagerDesignTemplates")
  nfcPlaques       NfcPlaque[]      @relation("NfcPlaques")
  performerProfile PerformerProfile?  @relation("PerformerProfile")
  performerEvents  PerformerEvent[]   @relation("PerformerEvents")
  performerBookings PerformerBooking[] @relation("PerformerBookings")
  waiterOrders      Order[]            @relation("WaiterOrders")

  @@index([restaurantId])
}

// ── Restaurant Manager expense ledger ──
// These belong to a RESTAURANT_MANAGER user (not a restaurant); each day holds
// a budget plus product/salary/additional expenses.
model ExpenseDay {
  id              String              @id @default(cuid())
  date            String // YYYY-MM-DD
  allocatedSum    Int                 @default(0) // whole so'm (not tiyin)
  report          String? // free-text end-of-day report
  isClosed        Boolean             @default(false)
  closedAt        DateTime?
  managerId       String
  manager         AdminUser           @relation("ManagerExpenseDays", fields: [managerId], references: [id], onDelete: Cascade)
  events          DayEvent[]
  extras          DayExtraExpense[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([managerId, date])
  @@index([managerId])
}

// Day-level "additional expenses" kept separate from the per-event main
// expenses. Managed on the Additional Expenses tab and exported separately.
model DayExtraExpense {
  id          String     @id @default(cuid())
  name        String
  amountSum   Int        @default(0) // whole so'm (not tiyin)
  sortOrder   Int        @default(0)
  dayId       String
  day         ExpenseDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([dayId])
}

// A department/event within a day: NAHOR, FOTIHA, TUI or OTHERS. Each holds its
// own product/salary/additional expense lines.
model DayEvent {
  id          String              @id @default(cuid())
  type        String // NAHOR | FOTIHA | TUI | OTHERS
  dayId       String
  day         ExpenseDay          @relation(fields: [dayId], references: [id], onDelete: Cascade)
  // Booking: guestCount * pricePerGuestSum is this event's guest revenue.
  bookingName      String?
  guestCount       Int            @default(0)
  pricePerGuestSum Int            @default(0) // whole so'm (not tiyin)
  report           String? // free-text notes for this event/department
  // Manual override of the guest revenue (the "revenue for all guests" figure).
  // Null means "guests x price per guest", which is the normal case; a number
  // wins over that product. Nullable rather than a 0 default so that
  // "overridden to zero" stays distinguishable from "not overridden" — mirrors
  // the manual total on the tablet Summary page. Additional services are added
  // on top of this either way, so overriding does not hide them.
  manualGuestsSum  Int?
  products    ProductExpense[]
  salaries    SalaryExpense[]
  additionals AdditionalExpense[]
  services    ServiceExpense[]
  createdAt   DateTime            @default(now())

  @@unique([dayId, type])
  @@index([dayId])
}

model ProductExpense {
  id          String   @id @default(cuid())
  name        String
  quantity    Float    @default(0)
  unit        String   @default("kg")
  amountSum   Int      @default(0) // whole so'm (not tiyin)
  sortOrder   Int      @default(0)
  eventId     String
  event       DayEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([eventId])
}

model SalaryExpense {
  id          String   @id @default(cuid())
  name        String
  amountSum   Int      @default(0) // whole so'm (not tiyin)
  sortOrder   Int      @default(0)
  eventId     String
  event       DayEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([eventId])
}

model AdditionalExpense {
  id          String   @id @default(cuid())
  name        String
  amountSum   Int      @default(0) // whole so'm (not tiyin)
  sortOrder   Int      @default(0)
  eventId     String
  event       DayEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([eventId])
}

// What the department spent on the "Additional Services" product (performers,
// invitations…). Same shape as AdditionalExpense but a SEPARATE section: an
// "additional expense" is any unplanned cost, whereas these track one specific
// paid product, and the two are reported and totalled apart.
// Additional Services sold for an event (performers, hosts, invitations…).
// Despite the name — kept so the table does not have to be renamed — these are
// REVENUE, not spending: the amount is added to the event's total alongside the
// guest revenue and never counted against it.
model ServiceExpense {
  id          String   @id @default(cuid())
  name        String
  amountSum   Int      @default(0) // whole so'm (not tiyin)
  sortOrder   Int      @default(0)
  eventId     String
  event       DayEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([eventId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  user             AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id          String       @id @default(cuid())
  name        String
  logoUrl     String?
  ownerId     String
  owner       AdminUser    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurants Restaurant[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([ownerId])
}

model Restaurant {
  id              String          @id @default(cuid())
  name            String
  address         String?
  phone           String?
  email           String?
  history         String?
  logoUrl         String?
  backgroundImageUrl String?
  categoryOrder   String?
  excludedCategories String?
  // Per-restaurant tablet/summary color palette (hex). Null → default gold theme.
  tabletAccentColor String?
  tabletBgColor     String?
  // Per-restaurant tablet cursor/finger-trail + falling-particle effects (like the
  // flyer/invitation builder). Null → defaults (sparkle trail in accent, no particles).
  tabletParticles         String?  // ParticleKind: none|confetti|birthday|snow|candy|hearts|custom
  tabletParticlesColor    String?
  tabletParticlesImageUrl String?
  tabletTrailTemplate     String?  // sparkle|hearts|candy|custom
  tabletTrailColor        String?
  tabletTrailImageUrl     String?
  // Master switch: when true, subcategories are disabled everywhere — the menu
  // items Subcategory column and the catering-site subcategory headers are hidden.
  hideSubcategories Boolean       @default(false)
  // ── Paid module entitlements, granted per restaurant by CHIEF_ADMIN ────────
  // New restaurants start locked; the migration backfills every existing row to
  // true so nobody already onboarded loses access on deploy.
  // Banquet module: the banquet staff roles (ADMIN/EMPLOYEE/KITCHEN) and the
  // admin panel at banquet.v-menu.uz/<slug>.
  moduleBanquet   Boolean         @default(false)
  // Catering module: the public food-service site at v-menu.uz/<slug> and the
  // CATERING_ADMIN role behind food-admin.v-menu.uz/<slug>.
  moduleCatering  Boolean         @default(false)
  // "Additional Services" — a separate product, NOT the banquet section's
  // ExtraService list. Nothing gates on it yet; the switch exists so it can be
  // sold and toggled ahead of the feature landing.
  moduleAddons    Boolean         @default(false)
  ownerId         String
  companyId       String?
  owner           AdminUser       @relation("OwnedRestaurants", fields: [ownerId], references: [id], onDelete: Cascade)
  company         Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  staff           AdminUser[]     @relation("StaffRestaurant")
  events          Event[]
  menuItems       MenuItem[]
  menuSubcategories MenuSubcategory[]
  tableCategories TableCategory[]
  halls           Hall[]
  invitations     Invitation[]
  reviews         Review[]
  extraServices   ExtraService[]
  orders          Order[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([ownerId])
  @@index([companyId])
}

// Additional paid services a restaurant offers alongside the banquet (decor,
// photographer, live music…). Guests pick them on the tablet Summary page; the
// selected ones are added to the total and listed in the PDF/Excel exports.
model ExtraService {
  id           String     @id @default(cuid())
  name         String
  description  String?
  // Price in tiyin (1/100 so'm), like every other money field.
  priceCents   Int        @default(0)
  // Photo/video URLs served from /uploads (JSON array of strings).
  media        Json       @default("[]")
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
}

model Review {
  id           String     @id @default(cuid())
  restaurantId String
  authorName   String
  rating       Int
  text         String?
  photoUrl     String?
  isApproved   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model TableCategory {
  id                 String                    @id @default(cuid())
  name               String
  includedCategories String                    @default("")
  ratePerPerson      Int                       @default(0)
  discountPercent    Int                       @default(0)
  // Table audience: ADULT (default) or CHILDREN. A CHILDREN table is shown as an
  // optional add-on table on the tablet, priced by a separate children count.
  tableType          String                    @default("ADULT")
  // Banquet event type this table belongs to: NAHOR | FOTIHA | TUI | OTHERS.
  // On the tablet the guest picks an event type first, then only its tables show.
  eventType          String                    @default("OTHERS")
  // How many hot appetizers the guest may pick for this set menu (default 3).
  hotAppetizerCount  Int                       @default(3)
  description        String?
  photoUrl           String?
  photos             Json                      @default("[]")
  // Per-table-category free-substitution dishes: MenuItem ids offered as free
  // swaps on the tablet for THIS table only. null = fall back to the legacy
  // global MenuItem.tabletStatus === 'FREE' behavior.
  freeSubstitutionItemIds Json?
  isActive           Boolean                   @default(true)
  sortOrder          Int                       @default(0)
  restaurantId       String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  events             Event[]
  packageItems       TableCategoryMenuItem[]
  restaurant         Restaurant?               @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model TableCategoryMenuItem {
  id              String        @id @default(cuid())
  tableCategoryId String
  menuItemId      String
  servings        Int           @default(1)
  tableCategory   TableCategory @relation(fields: [tableCategoryId], references: [id], onDelete: Cascade)
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([tableCategoryId, menuItemId])
  @@index([tableCategoryId])
}

model Hall {
  id           String      @id @default(cuid())
  name         String
  capacity     Int
  description  String?
  photoUrl     String?
  photos       Json        @default("[]")
  isActive     Boolean     @default(true)
  restaurantId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  events       Event[]
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model MenuItem {
  id               String                    @id @default(cuid())
  name             String
  description      String?
  // Optional per-language overrides for name/description, shown on the tablet and
  // catering site. Shape: { en?: string; ru?: string; uz?: string }. The base
  // name/description above act as the default/fallback when a locale is missing.
  nameI18n         Json?
  descriptionI18n  Json?
  category         MenuCategory
  priceCents       Int
  photoUrl         String?
  isActive         Boolean                   @default(true)
  showOnTablet     Boolean                   @default(true)
  // Tablet "Additional" status: NONE (hidden), FREE (free replacement only), PAID (paid additional item).
  tabletStatus     String                    @default("PAID")
  isBestseller     Boolean                   @default(false)
  isOutOfStock     Boolean                   @default(false)
  sortOrder        Int                       @default(0)
  restaurantId     String?
  // Optional subcategory grouping within the dish's category (catering site).
  subcategoryId    String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  selections       EventMenuSelection[]
  orderItems       OrderItem[]
  packageCategories TableCategoryMenuItem[]
  restaurant       Restaurant?              @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  subcategory      MenuSubcategory?         @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  @@index([category, isActive])
  @@index([restaurantId])
  @@index([subcategoryId])
}

// A named grouping of dishes inside a single MenuCategory, used to divide a
// category into sections on the catering site.
model MenuSubcategory {
  id           String       @id @default(cuid())
  name         String
  category     MenuCategory
  sortOrder    Int          @default(0)
  // When true, the subcategory header/chip is not rendered on the catering site;
  // its dishes fall back into the category's ungrouped block to save space.
  hidden       Boolean      @default(false)
  restaurantId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        MenuItem[]
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, category, name])
  @@index([restaurantId, category])
}

model EventMenuSelection {
  id             String   @id @default(cuid())
  eventId        String
  menuItemId     String
  quantity       Int
  unitPriceCents Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([eventId, menuItemId])
  @@index([eventId])
}

model Invitation {
  id              String    @id @default(cuid())
  slug            String    @unique
  eventId         String?   @unique
  // Optional: standalone flyers (for restaurants not in the system) have no restaurant.
  restaurantId    String?
  createdById     String?

  // Ordered freeform block layout for the WYSIWYG designer (JSON array of Block).
  // When empty, the public page falls back to the legacy fixed-section renderer.
  blocks          Json      @default("[]")

  // Top hero card (gift / promo)
  promoTitle      String?
  promoSubtitle   String?
  promoCode       String?
  promoImageUrl   String?

  // Secondary promo block under hero
  promoCodeAlt    String?
  promoDescription String?

  // Telegram CTA
  telegramUrl     String?
  telegramLabel   String?

  // Welcome / venue card
  welcomeTitle    String?
  welcomeSubtitle String?
  welcomeImageUrl String?
  welcomeMessage  String?

  // Countdown
  countdownAt     DateTime?
  countdownLabel  String?

  // Menu showcase items (JSON array of { number, name, photoUrl })
  menuItems       Json      @default("[]")

  // Photo gallery (JSON array of strings)
  galleryPhotos   Json      @default("[]")

  // Social + contacts
  instagramUrl    String?
  instagramLabel  String?
  phone           String?
  contactsTitle   String?
  contactVCardUrl String?

  // Theme / palette
  accentColor         String?
  backgroundColor     String?
  backgroundImageUrl  String?
  // Page-wide text color (blocks may override per-block).
  textColor           String?
  // Page-wide text size multiplier (1 = default).
  textScale           Float?  @default(1)
  // Falling particle effect: none | confetti | snow | candy | custom.
  particles           String?
  // Custom falling-particle image (used when particles = 'custom').
  particlesImageUrl   String?
  // Particle colour override (empty = sync with accent color).
  particlesColor      String?
  // Cursor/finger trail: sparkle | hearts | candy | custom.
  trailTemplate       String?
  trailColor          String?
  // Custom trail image (used when trailTemplate = 'custom').
  trailImageUrl       String?

  // Optional looping background music played on the public invitation
  musicUrl            String?

  // Telegram forwarding: unguessable code a user sends to the bot to subscribe
  // this flyer's form submissions to their chat. Null until first generated.
  telegramCode    String?  @unique

  isPublished     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event         Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  requests      InvitationRequest[]
  telegramLinks FlyerTelegramLink[]

  @@index([restaurantId])
  @@index([eventId])
}

// ── Telegram chat subscribed to a flyer's form submissions ────────────────────
// Created when someone sends the flyer's code to the bot; each new
// InvitationRequest is forwarded to every linked chat. Multiple chats per flyer
// are allowed (e.g. manager + assistant).
model FlyerTelegramLink {
  id           String   @id @default(cuid())
  invitationId String
  // Telegram chat id (stored as text — ids exceed 32-bit and can be negative).
  chatId       String
  username     String?
  firstName    String?
  createdAt    DateTime @default(now())

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, chatId])
  @@index([invitationId])
}

// ── Lead captured from a flyer's public "form" block ──────────────────────────
// A visitor leaves their contact so the manager can call them back.
model InvitationRequest {
  id           String   @id @default(cuid())
  invitationId String
  name         String
  phone        String
  message      String?
  createdAt    DateTime @default(now())

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

// ── Performers and hosts (Additional Services) ───────────────────────────────
// A PERFORMER or a HOST is an AdminUser with no restaurant. These three models
// are shared by both roles: the profile, calendar and booking flow are the same
// shape, and `AdminUser.role` is what decides which block a person appears in.
// Splitting them into parallel tables would mean fixing every future bug twice.
model PerformerProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  // Stage name shown to guests; falls back to the username when blank.
  displayName String
  bio         String?
  phone       String?
  avatarUrl   String?
  // JSON arrays of upload URLs.
  photos      Json    @default("[]")
  videos      Json    @default("[]")
  // Hidden from the public list without deleting the account.
  isVisible   Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user AdminUser @relation("PerformerProfile", fields: [userId], references: [id], onDelete: Cascade)
}

// One entry in a performer's calendar. Either added by hand or created when
// they accept a booking — `bookingId` is set only in the latter case.
model PerformerEvent {
  id          String   @id @default(cuid())
  performerId String
  eventDate   DateTime
  // Kept as a string alongside the date, matching how it is entered.
  eventTime   String
  title       String
  note        String?
  // The event programme. Hosts run to a running order, so they record it
  // against the calendar entry; it is carried over from the booking when the
  // entry was created by accepting one. Null for performers, who have none.
  program     String?
  bookingId   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  performer AdminUser        @relation("PerformerEvents", fields: [performerId], references: [id], onDelete: Cascade)
  booking   PerformerBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([performerId, eventDate])
}

// A booking request raised from the Additional Services page, for a performer
// or a host. Lands in their Notifications; accepting it creates the
// PerformerEvent above.
model PerformerBooking {
  id             String   @id @default(cuid())
  performerId    String
  restaurantName String
  contactName    String
  phone          String
  eventDate      DateTime
  eventTime      String
  eventType      String?
  note           String?
  // The running order for the evening. Required by the API when the person
  // being booked is a HOST — a host cannot judge whether to accept without it —
  // and always null for a performer, who is not asked for one.
  program        String?
  // PENDING | ACCEPTED | DECLINED
  status         String   @default("PENDING")
  // Provenance, when raised from a confirmed banquet event.
  restaurantId   String?
  eventNumber    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  performer AdminUser       @relation("PerformerBookings", fields: [performerId], references: [id], onDelete: Cascade)
  event     PerformerEvent?

  @@index([performerId, status])
  @@index([eventDate])
}

// ── Invitation order placed from the Additional Services page ────────────────
// A restaurant's guest fills this in (unauthenticated) and it lands on the
// v-invite.uz SYSTEM_ADMIN's Notifications page, where the studio builds the
// invitation by hand. Distinct from `InvitationRequest` above, which is a lead
// captured by a flyer's form block.
model InviteRequest {
  id             String   @id @default(cuid())
  // Honoree name(s) — a wedding has two, a birthday one, so this is a JSON
  // array of strings rather than fixed columns.
  names          Json     @default("[]")
  // Free string, not the EventType enum: this crosses into the v-invite world,
  // which has no reason to be pinned to the banquet product's enum.
  eventType      String
  phone          String
  // Where guests can send money gifts. Optional.
  cardNumber     String?
  restaurantName String
  // Captured as separate controls, and the time is often approximate, so it
  // stays a plain string rather than being folded into the DateTime.
  eventDate      DateTime
  eventTime      String
  menu           String?
  // JSON array of upload URLs. Plural from the start of real use: the honoree
  // usually has several photos for the designers to choose from.
  photoUrls      Json     @default("[]")
  dressCode      String?
  // Provenance when the order came from a confirmed banquet event rather than
  // from the standalone (banquet-disabled) page.
  restaurantId   String?
  eventNumber    Int?
  // Notifications-page state on the v-invite side.
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([isRead])
}

// ── Standalone guest invitation (wedding-style, not tied to a restaurant/event) ──
// Created by a MANAGER; rendered publicly on <slug>.invitation.v-menu.uz.
model GuestInvitation {
  id          String  @id @default(cuid())
  slug        String  @unique
  createdById String?

  // Ordered freeform block layout (JSON array of Block); empty → legacy renderer.
  blocks      Json    @default("[]")

  // Theme + cursor/finger trail
  accentColor        String?
  backgroundColor    String?
  backgroundImageUrl String?
  // Page-wide text color (blocks may override per-block).
  textColor          String?
  // Page-wide text size multiplier (1 = default).
  textScale          Float?  @default(1)
  // Falling particle effect: none | confetti | snow | candy.
  particles          String?
  musicUrl           String?
  trailTemplate      String  @default("sparkle") // sparkle | hearts | candy
  trailColor         String?

  // Hero (couple names + background photo)
  coupleNames  String?
  heroSubtitle String?
  heroImageUrl String?

  // Dear-guest message
  greetingTitle   String?
  greetingMessage String?
  coupleSignature String?

  // Venue / restaurant + map
  venueLabel     String?
  venueName      String?
  eventDate      DateTime?
  venueImageUrl  String?
  mapAddress     String?
  mapButtonLabel String?

  // Timing schedule (JSON array of { time, label })
  timingTitle String?
  timingItems Json    @default("[]")

  // Countdown
  countdownAt    DateTime?
  countdownLabel String?

  // Contacts / brand
  telegramUrl  String?
  phone        String?
  instagramUrl String?
  brandLabel   String?

  // RSVP
  rsvpTitle   String?
  rsvpEnabled Boolean @default(true)

  // Per-section animations: { sectionKey: { type, durationMs, delayMs } }
  sectionAnimations Json @default("{}")

  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy AdminUser?              @relation("ManagerGuestInvitations", fields: [createdById], references: [id], onDelete: SetNull)
  rsvps     GuestInvitationRsvp[]

  @@index([createdById])
}

model GuestInvitationRsvp {
  id           String   @id @default(cuid())
  invitationId String
  guestName    String
  attending    Boolean  @default(true)
  createdAt    DateTime @default(now())

  invitation GuestInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

// A manager-private reusable design snapshot (blocks + theme) for the WYSIWYG
// designer. `kind` separates flyer templates from invitation templates.
model DesignTemplate {
  id        String   @id @default(cuid())
  ownerId   String?
  name      String
  kind      String // flyer | invitation | plaque
  blocks    Json     @default("[]")
  theme     Json     @default("{}")
  // Pinned to the top of the template chooser.
  isFavorite Boolean @default(false)
  createdAt DateTime @default(now())

  owner AdminUser? @relation("ManagerDesignTemplates", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

// ══════════════════════════════════════════════════════════════════════════════
// v-invite.uz — standalone public invitation-builder product. Its users, sessions,
// projects and templates are fully separate from the v-menu AdminUser world.
// ══════════════════════════════════════════════════════════════════════════════

model InviteUser {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  // Null for Google-only accounts.
  passwordHash String?
  // Google account subject (sub claim) when signed in / linked via Google.
  googleId     String?  @unique
  displayName  String?
  avatarUrl    String?
  // "USER" (default) or "SYSTEM_ADMIN" — system admins get the Design+ panel
  // in the rich editor (custom overlay elements, palettes, video covers).
  role         String   @default("USER")
  createdAt    DateTime @default(now())

  sessions  InviteSession[]
  projects  InviteProject[]
  templates InviteTemplate[]
}

// System-admin control over how the built-in templates are presented on the
// v-invite promotional site: which are featured on the hero cover, in what
// order the rest are listed, and which are kept off it entirely.
//
// One row, keyed by `scope`, so a second promotional surface later needs no
// migration. Every list holds template ids and is advisory: ids that no longer
// match a shipped template are ignored at read time, and a template mentioned
// in none of the lists still appears — otherwise adding a template would make
// it invisible until an admin happened to re-save this.
model InvitePromoShowcase {
  id        String   @id @default(cuid())
  scope     String   @unique // "landing"
  coverIds  Json     @default("[]") // ordered ids featured on the hero cover
  orderIds  Json     @default("[]") // ordered ids for the "our work" grid
  hiddenIds Json     @default("[]") // ids kept off the promotional site
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// System-admin design override for a built-in rich template: `config` replaces
// the template's defaultConfig for new invitations, cards and previews.
// SYSTEM_ADMIN settings for one built-in rich template. Templates themselves are
// code, not rows (see vinvite/templates/index.ts), so this table exists purely to
// hold what the studio decides ABOUT a template: its saved Design+ config, and
// its commercial tier and price.
//
// One row per template rather than two tables — the key is the same and both
// halves are edited by the same person on the same screen. Both are nullable, so
// a template that has never been priced is distinguishable from one priced at
// zero.
model InviteTemplateOverride {
  id         String   @id @default(cuid())
  templateId String   @unique
  config     Json     @default("{}")
  // STANDARD | PREMIUM | LUXURY. A plain String like the other status columns in
  // this schema, so adding a tier later needs no migration.
  tier       String?
  // In tiyin (1/100 so'm), matching the rest of the platform's money columns.
  priceCents Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Per-device refresh session — powers the "Devices" tab.
model InviteSession {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())

  user InviteUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// An invitation project built in the block designer; published (when a free slug
// is claimed) at <slug>.v-invite.uz.
model InviteProject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  slug        String?  @unique
  isPublished Boolean  @default(false)
  blocks      Json     @default("[]")
  theme       Json     @default("{}")
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Telegram forwarding: unguessable code the owner sends to the RSVP bot to
  // subscribe this project's RSVPs to their chat. Null until first generated.
  telegramCode String? @unique

  user          InviteUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvps         InviteRsvp[]
  telegramLinks InviteTelegramLink[]

  @@index([userId])
}

// ── Telegram chat subscribed to a v-invite project's RSVPs ────────────────────
// Created when someone sends the project's code to the RSVP bot; each new
// InviteRsvp is forwarded to every linked chat.
model InviteTelegramLink {
  id        String   @id @default(cuid())
  projectId String
  // Telegram chat id (stored as text — ids exceed 32-bit and can be negative).
  chatId    String
  username  String?
  firstName String?
  createdAt DateTime @default(now())

  project InviteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, chatId])
  @@index([projectId])
}

// A guest's RSVP submitted from a published invitation (v-invite.uz/<slug>).
// Reviewed by the invitation's owner in the editor's "Guest responses" tab.
model InviteRsvp {
  id        String   @id @default(cuid())
  projectId String
  guestName String
  attending Boolean
  // Party size including the guest; 0 when declining.
  guests    Int      @default(1)
  // Dietary restrictions / special requests.
  dietary   String?
  // A congratulation message for the honoree.
  message   String?
  createdAt DateTime @default(now())

  project InviteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// A user-private reusable design snapshot for seeding new invitations.
model InviteTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  blocks    Json     @default("[]")
  theme     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user InviteUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── NFC plaque (v-connect.uz) ────────────────────────────────────────────────
// A block-designed page for a business, published at v-connect.uz/<slug> and
// reached by tapping an NFC tag. Built in the nfc.v-connect.uz builder by an
// NFC_MAKER; the same shared block designer that powers flyers/invitations.
model NfcPlaque {
  id          String  @id @default(cuid())
  slug        String  @unique
  createdById String?

  // Business identity shown in the builder list (and as the default title).
  businessName String
  // Ordered freeform block layout (JSON array of Block).
  blocks       Json    @default("[]")

  // Theme (mirrors the flyer/invitation theme columns).
  accentColor        String?
  backgroundColor    String?
  backgroundImageUrl String?
  textColor          String?
  textScale          Float?  @default(1)
  particles          String?
  particlesColor     String?
  particlesImageUrl  String?
  musicUrl           String?
  trailTemplate      String  @default("sparkle")
  trailColor         String?
  trailImageUrl      String?

  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   AdminUser? @relation("NfcPlaques", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

// ── Platform contact details (v-connect / v-invite) ──────────────────────────
// One row per brand. Shown under the "developed by" credit on every published
// flyer (brand "vconnect") and every v-invite invitation (brand "vinvite"), so
// a visitor can always reach the studio that built the page.
//   vconnect → edited by a v-menu CHIEF_ADMIN; a flyer may override it locally
//              with its own vccontact block.
//   vinvite  → edited by a v-invite SYSTEM_ADMIN only, and never overridable.

// ── Food-service orders (test.v-menu.uz → waiter) ───────────────────────────
// The guest builds a cart on the food-service site and places an order without
// an account. That produces a PENDING order and a short handoff CODE, which the
// guest reads out to a waiter; the waiter enters the code plus the table number
// on their own device, and only then does the order become theirs (OPEN).
//
// Two identifiers, deliberately different jobs:
//   `code`       3 characters, shown to the guest, spoken aloud. Short enough to
//                read across a table, so it is NOT a secret and is only unique
//                among the orders that can still be claimed (partial unique
//                index in the migration) — it is reusable once an order closes.
//   `guestToken` long and random, stored on the guest's device, never displayed.
//                The only thing proving an anonymous device owns this order, so
//                every public read/write is keyed on it rather than on the id.
model Order {
  id            String    @id @default(cuid())
  restaurantId  String
  code          String
  // PENDING (placed, awaiting a waiter) | OPEN (claimed) | CLOSED | CANCELLED.
  // A plain String like PerformerBooking.status — new states need no migration.
  status        String    @default("PENDING")
  guestToken    String    @unique
  // Free text from the guest for the kitchen. The waiter may edit it later.
  comment       String?
  // Entered by the waiter at claim time; the guest never types it. There is no
  // Table model — TableCategory is a banquet price package, not a physical table.
  tableNumber   String?
  waiterId      String?
  claimedAt     DateTime?
  closedAt      DateTime?
  // Set when the guest presses "call waiter", cleared when the waiter
  // acknowledges. A timestamp rather than a boolean so the waiter's list can
  // show how long someone has been waiting.
  callPendingAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  waiter     AdminUser?  @relation("WaiterOrders", fields: [waiterId], references: [id], onDelete: SetNull)
  items      OrderItem[]

  @@index([restaurantId, status])
  @@index([waiterId, status])
  @@index([waiterId, closedAt])
  @@index([restaurantId, createdAt])
}

// A line on an order. Unlike the guest's cart — which stores ids only, so a
// price the restaurant edits is always reflected — an order SNAPSHOTS the name
// and price at the moment it was placed. An order is a financial record: what
// the guest agreed to must not change because the menu was edited afterwards.
// Mirrors EventMenuSelection.unitPriceCents.
model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  // Nullable so deleting a dish never destroys order history; the snapshot below
  // keeps the line readable regardless.
  menuItemId     String?
  nameSnapshot   String
  unitPriceCents Int
  quantity       Int

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model PlatformContact {
  id        String   @id @default(cuid())
  brand     String   @unique // "vconnect" | "vinvite"
  phone     String?
  telegram  String?
  instagram String?
  updatedAt DateTime @updatedAt
}

