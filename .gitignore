node_modules/
# SQLite database
apps/api/prisma/dev.db
apps/api/prisma/dev.db-journal
apps/api/prisma/dev.db-wal
apps/api/prisma/dev.db-shm

# Build output (regenerated by deploy.sh)
apps/api/dist/
apps/web/dist/

# Compiled cruft in TS source tree (Vite compiles .tsx directly)
apps/web/src/**/*.js
apps/web/src/*.js

# Runtime uploads (server is source of truth; existing tracked files kept)
apps/api/uploads/

# Environment files. These were TRACKED until now, which meant the repo's
# development values (a SQLite DATABASE_URL and a placeholder JWT_SECRET) could
# be restored over the server's real configuration by any checkout, reset or
# stash — and the API would then start against the wrong database, or worse,
# sign tokens with a secret published in this repository.
# `.env.example` is committed in their place.
.env.local
apps/api/.env
apps/api/.env.local
apps/web/.env
apps/web/.env.local

# Postgres docker credentials (the .env next to docker-compose.yml)
/.env

# Generated read-only client for the one-time SQLite->Postgres migration
apps/api/src/generated/

# Old SQLite migrations kept locally for reference (still in git history)
apps/api/prisma/migrations.sqlite-archive/
